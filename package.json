{
  "name": "custom-media-player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal full-screen player for local images, video and audio",
  "scripts": {
    "start": "node serve.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "./tests/e2e/run.sh",
    "test:media": "./tests/e2e/make-media.sh",
    "test:all": "npm test && npm run test:e2e",
    "build:web": "node scripts/build-ts.mjs && node scripts/build-frontend.mjs",
    "desktop:dev": "npm run build:web && tauri dev",
    "desktop:build": "tauri build",
    "icon": "tauri icon icon-source.png",
    "build:web:watch": "node scripts/build-ts.mjs --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run typecheck && npm run build:web",
    "package:electron": "node scripts/package-electron.mjs",
    "build:ts": "node scripts/build-ts.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "jsdom": "^30.1.1",
    "vitest": "^5.0.2",
    "typescript": "^5.9.0",
    "esbuild": "^0.28.0",
    "@electron/packager": "^18.0.0"
  }
}
