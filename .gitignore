# the test tooling is installed, not vendored
node_modules/
package-lock.json

# editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/

# the app itself has no build output, but keep stray captures out
*.log

# e2e fixtures are generated, and screenshots are scratch
tests/e2e/media/

# build output: dist/ is assembled from an allowlist, and src-tauri/target is
# several gigabytes of compiled Rust. Neither belongs in version control.
dist/
dist-artifacts/
packaging/*.pkg.tar.*
packaging/src/
packaging/pkg/
packaging/*.BUILDINFO
packaging/*.PKGINFO
packaging/*.MTREE
src-tauri/target/
src-tauri/gen/schemas/

# Built binaries handed over for manual testing
artifacts/

# Sourcemaps are regenerated by the build and only useful next to a
# debug build.
js/*.map

# The frontend copied in at package time; dist/ at the root is the one that is
# committed.
shells/electron/dist/
